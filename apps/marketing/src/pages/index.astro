---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const providers = [
  {
    name: "Claude Code",
    tagline: "Use your existing Claude Code installation and subscription",
    cmd: "claude auth login",
  },
  {
    name: "Codex CLI",
    tagline: "Use your existing OpenAI Codex CLI installation and account",
    cmd: "codex login",
  },
  {
    name: "OpenCode",
    tagline: "Connect OpenCode and the models configured in its CLI",
    cmd: "opencode auth login",
  },
  {
    name: "Cursor",
    tagline: "Run Cursor CLI threads from the same Kairo workspace",
    cmd: "agent login",
  },
  {
    name: "Grok",
    tagline: "Connect the Grok Build CLI without changing your workflow",
    cmd: "grok login",
  },
];

const appModes = [
  {
    id: "canvas",
    name: "Chat Workspace",
    label: "Agents",
    desc: "Run coding agents, inspect tool activity, and attach project files.",
  },
  {
    id: "workspace",
    name: "Projects & Threads",
    label: "Organize",
    desc: "Keep durable threads grouped by project and environment.",
  },
  {
    id: "briefing",
    name: "Pull Request Review",
    label: "Review",
    desc: "Inspect diffs, review pull requests, and send line-level requests to an agent.",
  },
  {
    id: "split",
    name: "Browser & Terminal",
    label: "Tools",
    desc: "Keep browser previews and a real terminal beside the conversation.",
  },
];
---

<Layout
  title="Kairo · Open-source control plane for coding agents"
  description="Run Claude Code, Codex, Cursor, Grok, and OpenCode from one fast, local-first workspace on web, desktop, and mobile."
>
  <!-- ══════════════════════════════════════════════════════════
       1. HERO SECTION
       ══════════════════════════════════════════════════════════ -->
  <section class="k-hero-stage" id="hero">
    <div class="k-container k-hero-container">
      <div class="k-hero-layout-grid">
        <div class="k-hero-left">
          <!-- Status Badge -->
          <div class="k-live-badge k-reveal">
            <span class="k-pulse-dot"></span>
            <span class="k-badge-text">OPEN-SOURCE AGENT CONTROL PLANE</span>
          </div>

          <!-- Headline -->
          <h1 class="k-hero-title k-reveal">
            One workspace for<br />
            <span class="k-title-gradient">every coding agent.</span>
          </h1>

          <!-- Subtitle -->
          <p class="k-hero-subtitle k-reveal">
            Run Claude Code, Codex, Cursor, Grok, and OpenCode from one surface. Bring your own subscription. Keep the source.
          </p>

          <!-- CTA Action Buttons -->
          <div class="k-hero-actions k-reveal">
            <a href="#download" class="k-btn k-btn--primary k-btn--lg">
              <span class="symbol">download</span>
              <span>Download for Desktop</span>
            </a>
          </div>

          <div class="k-hero-trust-row k-reveal">
            <span class="k-trust-item"><span class="symbol icon-blue" style="font-size:16px">verified</span> Bring your own subscription</span>
            <span class="k-trust-item"><span class="symbol icon-green" style="font-size:16px">lock</span> Local-first server</span>
            <span class="k-trust-item"><span class="symbol icon-purple" style="font-size:16px">sync</span> Web, desktop, and mobile</span>
          </div>
        </div>

        <div class="k-hero-right">
          <!-- Live Interactive Prompt Simulator -->
          <div class="k-prompt-sim-card k-reveal-scale">
            <div class="k-prompt-sim-top">
              <div class="k-window-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <div class="k-sim-engine-pills">
                <button class="k-engine-pill active" data-engine="Claude Code">Claude Code</button>
                <button class="k-engine-pill" data-engine="Codex CLI">Codex</button>
                <button class="k-engine-pill" data-engine="OpenCode">OpenCode</button>
              </div>
            </div>
            <div class="k-prompt-input-row">
              <div class="k-prompt-icon-bubble">
                <span class="symbol">auto_awesome</span>
              </div>
              <input
                type="text"
                id="k-sim-input"
                class="k-sim-text-input"
                value="Review this branch and fix the failing tests"
                readonly
              />
              <button class="k-sim-send-btn" id="k-sim-send" title="Run prompt">
                <span class="symbol">arrow_upward</span>
              </button>
            </div>
            <div class="k-prompt-chips">
              <span class="k-chip-label">Quick suggestions:</span>
              <button class="k-prompt-chip active" data-prompt="Review this branch and fix the failing tests">fix failing tests</button>
              <button class="k-prompt-chip" data-prompt="Explain the authentication flow in this repository">explain a code path</button>
              <button class="k-prompt-chip" data-prompt="Prepare this branch for pull request review">prepare a pull request</button>
            </div>
            <div class="k-prompt-sim-result" id="k-sim-result">
              <div class="k-sim-res-header">
                <span class="k-memory-tag">
                  <span class="symbol" style="font-size:12px">save</span>
                  <span>Working in project: kairo &middot; branch: feature/auth</span>
                </span>
                <span class="k-sim-time">Just now</span>
              </div>
              <p class="k-sim-res-text" id="k-sim-text">
                Found <strong>2 failing tests</strong>. Updated the session boundary, reran the focused suite, and left the diff ready for review.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       2. VIDEO SHOWCASE (SEE KAIRO IN A MINUTE)
       ══════════════════════════════════════════════════════════ -->
  <section class="k-section k-video-section" id="trailer">
    <div class="k-container">
      <div class="k-section-header k-text-center k-reveal">
        <span class="k-section-pill">60-Second Overview</span>
        <h2 class="k-section-heading">See Kairo in a minute</h2>
        <p class="k-section-lead">
          Start an agent, follow its work, review the diff, and keep going from another device.
        </p>
      </div>

      <div class="k-video-player-wrapper k-reveal-scale">
        <div class="k-video-glow"></div>
        <div class="k-video-frame">
          <video
            id="k-main-video"
            src="/uploads/kairo-promo-v2.mp4"
            playsinline
            autoplay
            muted
            loop
            preload="auto"
            class="k-hero-video"
          ></video>
        </div>
      </div>

      <!-- 3 Highlights under Video -->
      <div class="k-video-bullets-grid">
        <div class="k-bullet-card k-reveal">
          <div class="k-bullet-icon">
            <span class="symbol">bolt</span>
          </div>
          <h4>Bring your own subscription</h4>
          <p>Kairo runs the provider CLIs you already install and authenticate.</p>
        </div>

        <div class="k-bullet-card k-reveal">
          <div class="k-bullet-icon">
            <span class="symbol">memory</span>
          </div>
          <h4>Durable agent threads</h4>
          <p>Projects, conversations, tool activity, and checkpoints stay available across sessions.</p>
        </div>

        <div class="k-bullet-card k-reveal">
          <div class="k-bullet-icon">
            <span class="symbol">security</span>
          </div>
          <h4>Remote when you need it</h4>
          <p>Use Kairo locally, over your network, or through its remote connection flow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       3. SPECIALITIES & FEATURES BENTO GRID
       ══════════════════════════════════════════════════════════ -->
  <section class="k-section k-features-section" id="features">
    <div class="k-container">
      <div class="k-features-top-bar k-reveal">
        <div>
          <span class="k-section-pill">Coding Agent Workspace</span>
          <h2 class="k-section-heading">Built around real agent workflows</h2>
        </div>
        <p class="k-features-subhead">
          Run multiple providers, inspect their work, manage source control, and reconnect from any Kairo client.
        </p>
      </div>

      <div class="k-bento-grid">
        <!-- Feature 1: Understand Documents -->
        <div class="k-bento-card k-reveal" data-spotlight>
          <div class="k-card-header">
            <div class="k-icon-box k-icon-purple">
              <span class="symbol">description</span>
            </div>
            <span class="k-card-tag">Document Intelligence</span>
          </div>
          <h3 class="k-card-title">Work inside real codebases</h3>
          <p class="k-card-desc">
            Give an agent a project, attach files or screenshots, and follow every tool call without leaving the conversation.
          </p>

          <!-- Rich Document Preview Widget -->
          <div class="k-doc-preview-widget">
            <div class="k-doc-header-row">
              <div class="k-doc-file-info">
                  <span class="symbol k-pdf-icon">description</span>
                <div>
                  <strong class="k-doc-filename">auth-session.ts</strong>
                  <span class="k-doc-meta">Project file &middot; Working tree</span>
                </div>
              </div>
              <span class="k-status-badge-green">Parsed</span>
            </div>
            <div class="k-doc-insights-list">
              <div class="k-insight-item">
                <span class="symbol k-check-icon">check_circle</span>
                <span>Traced the session lifecycle across client and server</span>
              </div>
              <div class="k-insight-item">
                <span class="symbol k-check-icon">check_circle</span>
                <span>Updated the typed contract and both consumers</span>
              </div>
              <div class="k-insight-item">
                <span class="symbol k-check-icon">check_circle</span>
                <span>Focused tests pass; diff is ready to review</span>
              </div>
            </div>
            <div class="k-doc-footer-meta">
              <span class="symbol">bolt</span>
              <span>3 files changed &middot; +42 / −18</span>
            </div>
          </div>
        </div>

        <!-- Feature 2: Draft & Summarize -->
        <div class="k-bento-card k-reveal" data-spotlight>
          <div class="k-card-header">
            <div class="k-icon-box k-icon-blue">
              <span class="symbol">edit_note</span>
            </div>
            <span class="k-card-tag">Smart Synthesis</span>
          </div>
          <h3 class="k-card-title">Review before changes land</h3>
          <p class="k-card-desc">
            Inspect agent diffs, pull request details, review verdicts, and line-level feedback in the same workspace.
          </p>

          <!-- Rich Tone Switcher Widget -->
          <div class="k-tone-widget">
            <div class="k-tone-switcher">
              <button class="k-tone-btn active" data-tone="short">Summary</button>
              <button class="k-tone-btn" data-tone="detailed">Findings</button>
              <button class="k-tone-btn" data-tone="casual">Request</button>
              <button class="k-tone-btn" data-tone="executive">Verdict</button>
            </div>
            <div class="k-tone-preview-box">
              <div class="k-tone-quote-row">
                <span class="symbol icon-blue" style="font-size:16px">format_quote</span>
                <span class="k-tone-meta-pill" id="k-tone-word-count">14 words &middot; ~2s read</span>
              </div>
              <p id="k-tone-preview-text">"Three files changed. Focused tests pass. Ready for review."</p>
              <div class="k-tone-preview-footer">
                <span class="k-tone-tone-label">Review: Summary</span>
                <button class="k-copy-snippet-btn" id="k-copy-tone-btn" title="Copy preview text">
                  <span class="symbol">content_copy</span>
                  <span>Copy</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 3: Durable Threads -->
        <div class="k-bento-card k-reveal" data-spotlight>
          <div class="k-card-header">
            <div class="k-icon-box k-icon-green">
              <span class="symbol">psychology</span>
            </div>
            <span class="k-card-tag">Durable Threads</span>
          </div>
          <h3 class="k-card-title">Threads that survive restarts</h3>
          <p class="k-card-desc">
            Kairo keeps project threads, provider activity, and checkpoints durable so work can resume where it stopped.
          </p>

          <!-- Durable Thread Context Widget -->
          <div class="k-memory-widget">
            <div class="k-memory-chips-demo">
              <div class="k-mem-pill active" data-mem-pill>
                <div class="k-mem-pill-left">
                  <span class="symbol mem-icon">check</span>
                  <div>
                    <strong class="k-mem-key">Project:</strong>
                    <span class="k-mem-val">kairo &middot; apps/web</span>
                  </div>
                </div>
                <span class="k-mem-category-tag">Project</span>
              </div>
              <div class="k-mem-pill active" data-mem-pill>
                <div class="k-mem-pill-left">
                  <span class="symbol mem-icon">check</span>
                  <div>
                    <strong class="k-mem-key">Provider:</strong>
                    <span class="k-mem-val">Codex &middot; Thread connected</span>
                  </div>
                </div>
                <span class="k-mem-category-tag">Agent</span>
              </div>
              <div class="k-mem-pill" data-mem-pill>
                <div class="k-mem-pill-left">
                  <span class="symbol mem-icon">add</span>
                  <div>
                    <strong class="k-mem-key">Checkpoint:</strong>
                    <span class="k-mem-val">Latest turn saved</span>
                  </div>
                </div>
                <span class="k-mem-category-tag">Git</span>
              </div>
            </div>
            <div class="k-memory-footer-note">
              <span class="symbol">sync</span>
              <span>Durable local state &middot; Resume from web, desktop, or mobile</span>
            </div>
          </div>
        </div>

        <!-- Feature 4: Connected Data & Tools -->
        <div class="k-bento-card k-reveal" data-spotlight>
          <div class="k-card-header">
            <div class="k-icon-box k-icon-yellow">
              <span class="symbol">hub</span>
            </div>
            <span class="k-card-tag">Direct Integrations</span>
          </div>
          <h3 class="k-card-title">The tools agents actually need</h3>
          <p class="k-card-desc">
            Keep Git, pull requests, a browser, previews, and a terminal beside the active thread.
          </p>

          <!-- Rich Tools Ecosystem Widget -->
          <div class="k-tools-grid-preview">
            <div class="k-tool-chip">
              <span class="symbol icon-blue">terminal</span>
              <div class="k-tool-info">
                <strong>Git</strong>
                <span>Diffs &amp; checkpoints</span>
              </div>
              <span class="k-tool-status-dot active"></span>
            </div>
            <div class="k-tool-chip">
              <span class="symbol icon-purple">linear_scale</span>
              <div class="k-tool-info">
                <strong>Pull Requests</strong>
                <span>Review &amp; update</span>
              </div>
              <span class="k-tool-status-dot active"></span>
            </div>
            <div class="k-tool-chip">
              <span class="symbol icon-green">forum</span>
              <div class="k-tool-info">
                <strong>Terminal</strong>
                <span>Interactive sessions</span>
              </div>
              <span class="k-tool-status-dot active"></span>
            </div>
            <div class="k-tool-chip">
              <span class="symbol icon-yellow">cloud</span>
              <div class="k-tool-info">
                <strong>Browser</strong>
                <span>Local previews</span>
              </div>
              <span class="k-tool-status-dot active"></span>
            </div>
          </div>
          <div class="k-tools-footer-badge">
            <span class="symbol">lock</span>
            <span>Agent tools stay attached to the project environment</span>
          </div>
        </div>

        <!-- Feature 5: Multi-Provider Orchestration (Wide Card) -->
        <div class="k-bento-card k-bento-wide k-reveal" data-spotlight>
          <div class="k-wide-layout">
            <div class="k-wide-info">
              <div class="k-card-header">
                <div class="k-icon-box k-icon-purple">
                  <span class="symbol">auto_awesome_motion</span>
                </div>
                <span class="k-card-tag">Unified Control Plane</span>
              </div>
              <h3 class="k-card-title">Choose the right agent for each thread</h3>
              <p class="k-card-desc">
                Use Claude Code, Codex, Cursor, Grok, or OpenCode without moving your projects into another editor.
              </p>
              <div class="k-wide-metrics-row">
                <div class="k-metric-pill">
                  <strong>5</strong>
                  <span>Agent Providers</span>
                </div>
                <div class="k-metric-pill">
                  <strong>3</strong>
                  <span>Client Surfaces</span>
                </div>
                <div class="k-metric-pill">
                  <strong>MIT</strong>
                  <span>Open Source</span>
                </div>
              </div>
            </div>
            <div class="k-provider-cards-col">
              {
                providers.map((p) => (
                  <div class="k-provider-mini-card">
                    <div class="k-pm-left">
                      <div class="k-pm-title-row">
                        <strong class="k-pm-name">{p.name}</strong>
                      </div>
                      <span class="k-pm-desc">{p.tagline}</span>
                    </div>
                    <div class="k-pm-right">
                      <span class="k-cli-shortcut-tag">{p.cmd}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Early access banner -->
      <div class="k-info-banner k-reveal">
        <span class="symbol icon-purple">lightbulb</span>
        <div>
          <strong>Kairo evolves in the open</strong> &middot; Recent releases expanded pull request review, remote environments, usage insights, file drops, themes, and mobile workflows.
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       4. INTERACTIVE UI MODES EXPLORER
       ══════════════════════════════════════════════════════════ -->
  <section class="k-section k-modes-section" id="modes">
    <div class="k-container">
      <div class="k-section-header k-text-center k-reveal">
        <span class="k-section-pill">Multi-Surface Workflow</span>
        <h2 class="k-section-heading">One workspace from prompt to pull request</h2>
        <p class="k-section-lead">
          Chat, projects, review tools, browser previews, and terminals stay connected to the same environment.
        </p>
      </div>

      <!-- Mode Selector Tabs -->
      <div class="k-mode-tabs-row k-reveal" id="k-mode-tab-buttons">
        {
          appModes.map((mode, i) => (
            <button
              class={`k-mode-tab-btn ${i === 0 ? "active" : ""}`}
              data-mode={mode.id}
            >
              <span class="k-tab-pill">{mode.label}</span>
              <span class="k-tab-name">{mode.name}</span>
            </button>
          ))
        }
      </div>

      <!-- Mode Preview Container -->
      <div class="k-mode-stage-wrapper k-reveal-scale">
        <!-- 1. Calm Canvas View (1a) -->
        <div class="k-mode-view active" id="view-canvas">
          <div class="k-canvas-inner">
            <div class="k-canvas-header">
              <div class="k-app-brand">
                <img src="/logo.png" alt="Kairo" width="18" height="18" style="border-radius: 4px; object-fit: cover;" />
                <span>kairo</span>
                <span class="k-canvas-mode-tag">Chat Workspace</span>
              </div>
              <div class="k-canvas-actions">
                <span class="k-status-indicator"><span class="k-pulse-dot-sm"></span> Agent Connected</span>
                <span class="symbol">tune</span>
              </div>
            </div>
            <div class="k-canvas-body">
              <div class="k-canvas-intro">
                <span class="k-canvas-eyebrow">Project: kairo</span>
                <h3 class="k-canvas-greeting">What should the agent change?</h3>
              </div>
              <div class="k-canvas-input-box">
                <div class="k-canvas-input-top">
                  <span class="symbol icon-purple" style="font-size:18px">auto_awesome</span>
                  <input type="text" placeholder="Ask about the codebase or describe a change..." value="Fix the auth regression and run the focused tests" readonly />
                </div>
                <div class="k-canvas-bottom-bar">
                  <div class="k-canvas-tools">
                    <span class="k-tool-btn"><span class="symbol">attach_file</span> Add File</span>
                    <span class="k-tool-btn"><span class="symbol">terminal</span> Terminal Ready</span>
                  </div>
                  <button class="k-canvas-send-btn" title="Submit prompt">
                    <span class="symbol">arrow_forward</span>
                  </button>
                </div>
              </div>
              <div class="k-canvas-chips-row">
                <span class="k-prompt-chip active">fix failing tests</span>
                <span class="k-prompt-chip">review this diff</span>
                <span class="k-prompt-chip">explain this code</span>
                <span class="k-prompt-chip">prepare a PR</span>
              </div>
              <div class="k-canvas-result-card">
                <div class="k-canvas-result-head">
                  <span class="k-memory-tag"><span class="symbol" style="font-size:12px">verified</span> Focused tests passed</span>
                  <span class="k-sim-time">Just now</span>
                </div>
                <p class="k-canvas-result-desc">
                  Fixed the session boundary, updated <strong>3 files</strong>, and left the working-tree diff ready for review.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Workspace Rails View (1b) -->
        <div class="k-mode-view" id="view-workspace">
          <div class="k-workspace-inner">
            <div class="k-ws-sidebar">
              <div class="k-app-brand">
                <img src="/logo.png" alt="Kairo" width="18" height="18" style="border-radius: 4px; object-fit: cover;" />
                <span>kairo</span>
              </div>
              <button class="k-new-btn">
                <span class="symbol">add</span>
                <span>New thread</span>
              </button>
              <div class="k-thread-list">
                <div class="k-thread-item active">
                  <div class="k-thread-title-row">
                    <span class="k-thread-status-dot green"></span>
                    <span class="k-thread-name">Cloudflare R2 vs S3</span>
                  </div>
                  <span class="k-thread-time">2m ago</span>
                </div>
                <div class="k-thread-item">
                  <div class="k-thread-title-row">
                    <span class="k-thread-status-dot purple"></span>
                    <span class="k-thread-name">Draft Sprint Retrospective</span>
                  </div>
                  <span class="k-thread-time">1h ago</span>
                </div>
                <div class="k-thread-item">
                  <div class="k-thread-title-row">
                    <span class="k-thread-status-dot blue"></span>
                    <span class="k-thread-name">Provider reconnect handling</span>
                  </div>
                  <span class="k-thread-time">Yesterday</span>
                </div>
              </div>
              <div class="k-ws-bottom-connected">
                <span class="k-conn-label">Connected Tools &middot; Online</span>
                <div class="k-conn-chips-list">
                  <span class="k-conn-badge"><span class="symbol">code</span> Git</span>
                  <span class="k-conn-badge"><span class="symbol">terminal</span> Terminal</span>
                </div>
              </div>
            </div>
            <div class="k-ws-main">
              <div class="k-ws-chat-area">
                <div class="k-chat-bubble user">
                  <div class="k-bubble-author">You &middot; 10:42 AM</div>
                  Trace the reconnect regression and update the focused tests.
                </div>
                <div class="k-chat-bubble assistant">
                  <div class="k-bubble-author-row">
                    <span class="k-bubble-author">Kairo &middot; Claude Code</span>
                    <span class="k-badge badge-green">Agent running</span>
                  </div>
                  <p>The reconnect path crosses two client states and one server receipt:</p>
                  <div class="k-ws-pricing-table">
                    <div class="k-pricing-row highlight">
                      <span class="k-provider-name">Client runtime</span>
                      <span class="k-provider-cost">Updated</span>
                      <span class="k-provider-note">Reconnect state</span>
                    </div>
                    <div class="k-pricing-row">
                      <span class="k-provider-name">Server receipt</span>
