  <!-- Client-side Interactive Behaviors -->
  <script is:inline>
    // 1. Interactive App Modes Switcher
    const modeButtons = document.querySelectorAll('.k-mode-tab-btn');
    const modeViews = document.querySelectorAll('.k-mode-view');

    modeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        modeButtons.forEach((b) => b.classList.remove('active'));
        modeViews.forEach((v) => v.classList.remove('active'));
        btn.classList.add('active');
        const activeView = document.getElementById(`view-${mode}`);
        if (activeView) activeView.classList.add('active');
      });
    });

    // 2. Interactive Prompt Simulator with Natural Typing Stream
    const simChips = document.querySelectorAll('.k-prompt-chip');
    const simInput = document.getElementById('k-sim-input');
    const simText = document.getElementById('k-sim-text');
    let typingTimer = null;

    const streamResponse = (text) => {
      if (!simText) return;
      simText.textContent = '';
      let i = 0;
      clearInterval(typingTimer);
      typingTimer = setInterval(() => {
        if (i < text.length) {
          simText.textContent += text.charAt(i);
          i++;
        } else {
          clearInterval(typingTimer);
        }
      }, 12);
    };

    const promptResponses = {
      "Review this branch and fix the failing tests": "Found two failing reconnect tests. Updated the session boundary, reran the focused suite, and left the diff ready for review.",
      "Explain the authentication flow in this repository": "Traced pairing from the client request through the server receipt and summarized the expiration and recovery paths.",
      "Prepare this branch for pull request review": "Reviewed the working tree, ran targeted checks, and prepared a concise summary of the files and behavior changed."
    };

    simChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        simChips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        const p = chip.getAttribute('data-prompt');
        if (p && simInput && simText) {
          simInput.value = p;
          streamResponse(promptResponses[p] || "Ready to work in the active project.");
        }
      });
    });

    // 3. One-Click Copy for CLI Terminal Commands with Global Toast
    document.querySelectorAll('.k-cli-row').forEach((row) => {
      row.addEventListener('click', () => {
        const cmd = row.getAttribute('data-copy-cmd');
        if (cmd) {
          navigator.clipboard.writeText(cmd).then(() => {
            const btn = row.querySelector('.k-copy-btn');
            if (btn) {
              btn.innerHTML = '<span class="symbol" style="color:#4ade80">check</span>';
              setTimeout(() => {
                btn.innerHTML = '<span class="symbol">content_copy</span>';
              }, 2000);
            }
            if (window.showToast) {
              window.showToast(`Copied to clipboard: ${cmd}`);
            }
          });
        }
      });
    });

    // 4. Video Autoplay, Floating Pop-out & Audio Synchronization
    const mainVideo = document.getElementById('k-main-video');
    const trailerSection = document.getElementById('trailer');
    const pipPlayer = document.getElementById('k-pip-player');
    const pipVideo = document.getElementById('k-pip-video');
    const mainSoundToggle = document.getElementById('k-main-sound-toggle');
    const mainSoundIcon = document.getElementById('k-main-sound-icon');
    const mainSoundText = document.getElementById('k-main-sound-text');
    const pipMuteBtn = document.getElementById('k-pip-mute-btn');
    const pipMuteIcon = document.getElementById('k-pip-mute-icon');
    const pipExpandBtn = document.getElementById('k-pip-expand-btn');
    const pipCloseBtn = document.getElementById('k-pip-close-btn');

    let pipDismissed = false;
    let isAudioUnmuted = false;
    let isTrailerInView = false;

    const checkTrailerVisibility = () => {
      if (!trailerSection) return false;
      const rect = trailerSection.getBoundingClientRect();
      return rect.top < window.innerHeight && rect.bottom > 0;
    };

    const triggerVideoExperience = () => {
      isTrailerInView = checkTrailerVisibility();

      if (mainVideo && mainVideo.paused) {
        mainVideo.play().catch(() => {});
      }

      if (!isTrailerInView && !pipDismissed && pipPlayer && pipVideo) {
        pipPlayer.classList.add('is-visible');
        if (mainVideo && Math.abs(pipVideo.currentTime - mainVideo.currentTime) > 1) {
          pipVideo.currentTime = mainVideo.currentTime;
        }
        if (pipVideo.paused) {
          pipVideo.play().catch(() => {});
        }
      }
    };

    ['mousemove', 'scroll', 'mouseenter', 'touchstart', 'pointerdown', 'keydown'].forEach((ev) => {
      window.addEventListener(ev, triggerVideoExperience, { passive: true });
    });
    triggerVideoExperience();

    const setAudioState = (unmuted) => {
      isAudioUnmuted = unmuted;
      if (mainVideo) mainVideo.muted = !unmuted;
      if (pipVideo) pipVideo.muted = !unmuted;

      if (mainSoundIcon && mainSoundText) {
        mainSoundIcon.textContent = unmuted ? 'volume_up' : 'volume_off';
        mainSoundText.textContent = unmuted ? 'Mute' : 'Click to unmute';
      }
      if (pipMuteIcon) {
        pipMuteIcon.textContent = unmuted ? 'volume_up' : 'volume_off';
      }
    };

    if (mainSoundToggle) {
      mainSoundToggle.addEventListener('click', () => {
        setAudioState(!isAudioUnmuted);
        if (mainVideo && mainVideo.paused) mainVideo.play().catch(() => {});
      });
    }

    if (pipMuteBtn) {
      pipMuteBtn.addEventListener('click', () => {
        setAudioState(!isAudioUnmuted);
      });
    }

    if (pipExpandBtn) {
      pipExpandBtn.addEventListener('click', () => {
        if (trailerSection) {
          trailerSection.scrollIntoView({ behavior: 'smooth' });
          if (mainVideo && pipVideo) {
            mainVideo.currentTime = pipVideo.currentTime;
            mainVideo.play().catch(() => {});
          }
        }
      });
    }

    if (pipCloseBtn) {
      pipCloseBtn.addEventListener('click', () => {
        pipDismissed = true;
        if (pipPlayer) pipPlayer.classList.remove('is-visible');
        if (pipVideo) pipVideo.pause();
      });
    }

    if (trailerSection && pipPlayer && mainVideo && pipVideo) {
      const observer = new IntersectionObserver(
        (entries) => {
          const [entry] = entries;
          isTrailerInView = entry.isIntersecting;
          if (!entry.isIntersecting && !pipDismissed) {
            pipVideo.currentTime = mainVideo.currentTime;
            pipPlayer.classList.add('is-visible');
            pipVideo.play().catch(() => {});
          } else {
            if (pipPlayer.classList.contains('is-visible')) {
              mainVideo.currentTime = pipVideo.currentTime;
              mainVideo.play().catch(() => {});
            }
            pipPlayer.classList.remove('is-visible');
          }
        },
        { threshold: 0.2 }
      );
      observer.observe(trailerSection);
    }



    // 6. Interactive Review Presets Switcher
    const toneButtons = document.querySelectorAll('.k-tone-btn');
    const tonePreviewText = document.getElementById('k-tone-preview-text');
    const toneWordCount = document.getElementById('k-tone-word-count');
    const toneLabelEl = document.querySelector('.k-tone-tone-label');
    const copyToneBtn = document.getElementById('k-copy-tone-btn');

    const toneSamples = {
      short: {
        text: '"Three files changed. Focused tests pass. Ready for review."',
        meta: '9 words · summary',
        label: 'Review: Summary'
      },
      detailed: {
        text: '"The reconnect guard now handles expired pairing tokens before restoring the active thread. Two focused tests cover recovery."',
        meta: '18 words · findings',
        label: 'Review: Findings'
      },
      casual: {
        text: '"Please add a regression case for a token that expires while the client is reconnecting."',
        meta: '14 words · request',
        label: 'Review: Change request'
      },
      executive: {
        text: '"Approve after the reconnect race has a focused regression test."',
        meta: '10 words · verdict',
        label: 'Review: Verdict'
      }
    };

    toneButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        toneButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const tone = btn.getAttribute('data-tone') || 'short';
        const sample = toneSamples[tone];
        if (sample) {
          if (tonePreviewText) tonePreviewText.textContent = sample.text;
          if (toneWordCount) toneWordCount.textContent = sample.meta;
          if (toneLabelEl) toneLabelEl.textContent = sample.label;
        }
      });
    });

    if (copyToneBtn) {
      copyToneBtn.addEventListener('click', () => {
        if (tonePreviewText) {
          navigator.clipboard.writeText(tonePreviewText.textContent.replace(/^"|"$/g, '')).then(() => {
            copyToneBtn.innerHTML = '<span class="symbol" style="color:#4ade80;font-size:13px">check</span> <span>Copied</span>';
            if (window.showToast) window.showToast('Copied synthesized tone sample', 'content_copy');
            setTimeout(() => {
              copyToneBtn.innerHTML = '<span class="symbol">content_copy</span> <span>Copy</span>';
            }, 2000);
          });
        }
      });
    }

    // 7. Interactive Thread Context Pills Toggle
    const memPills = document.querySelectorAll('[data-mem-pill]');
    memPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pill.classList.toggle('active');
        const icon = pill.querySelector('.mem-icon');
        if (icon) {
          icon.textContent = pill.classList.contains('active') ? 'check' : 'add';
        }
      });
    });

    // 8. Card Dynamic Spotlight Glow
    const spotlightCards = document.querySelectorAll('[data-spotlight]');
    spotlightCards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });

    // 9. Client Platform OS Detection (No recommendation tag)

    // 10. Interactive Review Action Check-offs
    document.querySelectorAll('.k-brief-action-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.k-brief-card');
        if (card) {
          card.classList.toggle('is-completed');
          if (card.classList.contains('is-completed')) {
            btn.innerHTML = '<span class="symbol" style="color:#4ade80; font-size:13px">check_circle</span> Done';
          } else {
            btn.innerHTML = 'Open review &rarr;';
          }
        }
      });
    });

    // 11. Navbar ScrollSpy Active Link Sync
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.ag-nav .ag-nav-btn');
    window.addEventListener('scroll', () => {
      let currentSectionId = '';
      sections.forEach((sec) => {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= 140 && rect.bottom >= 140) {
          currentSectionId = sec.id;
        }
      });
      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (href === `#${currentSectionId}`) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }, { passive: true });

    // 12. Hero Simulator Engine Selector Tabs
    const enginePills = document.querySelectorAll('.k-engine-pill');
    enginePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        enginePills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        const engineName = pill.getAttribute('data-engine') || 'Claude Code';
        if (window.showToast) {
          window.showToast(`Switched active engine to ${engineName}`, 'tune');
        }
      });
    });

    // 14. Interactive 3D Perspective Card Tilt
    const tiltCards = document.querySelectorAll('.k-prompt-sim-card, .k-bento-card, .k-terminal-card, .k-os-card');
    tiltCards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(1000px) rotateX(${y * -8}deg) rotateY(${x * 8}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
      });
    });

    // 15. Universal Scroll Reveal Engine for ALL parts of the website
    const initScrollReveal = () => {
      const revealTargets = document.querySelectorAll(
        '.k-reveal, .k-reveal-scale, .k-section-header, .k-bento-card, .k-bullet-card, .k-os-card, .k-terminal-card, .k-cta-box, .footer-col, .footer-pitch, .footer-bottom-bar'
      );

      revealTargets.forEach((el, index) => {
        const parent = el.parentElement;
        const siblings = parent ? Array.from(parent.children).filter(c => c.classList.contains('k-reveal') || c.classList.contains('k-reveal-scale') || c.classList.contains('k-bento-card') || c.classList.contains('k-bullet-card') || c.classList.contains('k-os-card')) : [];
        const siblingIndex = siblings.indexOf(el);
        const delay = siblingIndex > 0 ? `${(siblingIndex % 4) * 0.09}s` : `${(index % 3) * 0.05}s`;
        el.style.transitionDelay = delay;
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              entry.target.classList.add('in-view');
            }
          });
        },
        { threshold: 0.06, rootMargin: '0px 0px -40px 0px' }
      );

      revealTargets.forEach((el) => {
        revealObserver.observe(el);
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          el.classList.add('is-revealed');
          el.classList.add('in-view');
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollReveal);
    } else {
      initScrollReveal();
    }
  </script>

  <!-- Floating Picture-in-Picture Mini Video Player -->
  <div class="k-floating-pip-player" id="k-pip-player" aria-label="Floating video player">
    <div class="k-pip-header">
      <div class="k-pip-title">
        <span class="symbol icon-purple" style="font-size:16px">play_circle</span>
        <span>Kairo in 60s</span>
