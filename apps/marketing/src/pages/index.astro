  /* Interactive Prompt Simulator Card */
  .k-prompt-sim-card {
    position: relative;
    margin-top: 14px;
    background: rgba(18, 8, 36, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(214, 186, 255, 0.3);
    border-radius: 18px;
    padding: 18px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(168, 85, 247, 0.25);
    overflow: hidden;
    z-index: 1;
  }
  .k-prompt-sim-card::before,
  .k-bento-card.featured::before {
    content: '';
    position: absolute;
    inset: -150%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg 300deg,
      rgba(125, 211, 252, 0.7) 330deg,
      rgba(192, 132, 252, 0.9) 360deg
    );
    animation: kConicSpin 6s linear infinite;
    pointer-events: none;
    z-index: -1;
  }
  .k-prompt-sim-card::after,
  .k-bento-card.featured::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: #0d0818;
    border-radius: inherit;
    z-index: -1;
  }
  @keyframes kConicSpin {
    100% { transform: rotate(360deg); }
  }

  .k-float-levitate {
    animation: kFloatSlow 5s ease-in-out infinite alternate;
  }
  @keyframes kFloatSlow {
    0% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-7px) rotate(1deg); }
    100% { transform: translateY(0px) rotate(0deg); }
  }

