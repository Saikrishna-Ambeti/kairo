---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
---

<Layout title="Download Kairo for macOS, Windows, or Linux" description="Download Kairo desktop, then connect Claude Code, Codex, Cursor, Grok, or OpenCode.">
  <div class="download-page ag-container">
    <div class="download-header-center">
      <span class="ag-eyebrow">INSTALLATION</span>
      <h1 class="download-title">Download Kairo for your workstation.</h1>
      <p class="download-subtitle">
        <span id="version-label">Fetching latest release info...</span>
        <a id="changelog-link" class="ag-link-changelog" href="#" target="_blank" rel="noopener noreferrer" style="display:none">
          <span>Release notes</span>
          <span class="symbol">open_in_new</span>
        </a>
      </p>
    </div>

    <div class="download-grid" id="platforms">
      <!-- macOS -->
      <section class="dl-platform-card spotlight-card">
        <div class="dl-platform-header">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <div>
            <h2 class="dl-name">macOS</h2>
            <p class="dl-ver">macOS 12 Monterey or later</p>
          </div>
        </div>
        <div class="dl-buttons-list">
          <a class="download-card ag-btn-tile" data-asset="arm64.dmg" href={RELEASES_URL}>
            <span>Apple Silicon (M1/M2/M3/M4)</span>
            <span class="ext">.dmg</span>
          </a>
          <a class="download-card ag-btn-tile" data-asset="x64.dmg" href={RELEASES_URL}>
            <span>Intel (x64)</span>
            <span class="ext">.dmg</span>
          </a>
        </div>
      </section>

      <!-- Windows -->
      <section class="dl-platform-card spotlight-card">
        <div class="dl-platform-header">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
          <div>
            <h2 class="dl-name">Windows</h2>
            <p class="dl-ver">Windows 10, 11 (64-bit)</p>
          </div>
        </div>
        <div class="dl-buttons-list">
          <a class="download-card ag-btn-tile" data-asset="x64.exe" href={RELEASES_URL}>
            <span>Windows Installer</span>
            <span class="ext">.exe</span>
          </a>
        </div>
      </section>

      <!-- Linux -->
      <section class="dl-platform-card spotlight-card">
        <div class="dl-platform-header">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z"/></svg>
          <div>
            <h2 class="dl-name">Linux</h2>
            <p class="dl-ver">Universal binary</p>
          </div>
        </div>
        <div class="dl-buttons-list">
          <a class="download-card ag-btn-tile" data-asset="x86_64.AppImage" href={RELEASES_URL}>
            <span>Universal AppImage</span>
            <span class="ext">.AppImage</span>
          </a>
        </div>
      </section>
    </div>

    <p class="releases-link-note">
      Looking for previous versions or source code? Check the
      <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
        GitHub releases archive
      </a>.
    </p>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL } from "../lib/releases";

  async function init() {
    const versionLabel = document.getElementById("version-label");
    const cards = document.querySelectorAll<HTMLAnchorElement>(".download-card");

    try {
      const release = await fetchLatestRelease();

      if (versionLabel && release.tag_name) {
        versionLabel.textContent = `Latest release: ${release.tag_name}`;
      }

      const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement | null;
      if (changelogLink && release.html_url) {
        changelogLink.href = release.html_url;
        changelogLink.style.display = "inline-flex";
      }

      cards.forEach((card) => {
        const suffix = card.dataset.asset;
        if (!suffix) return;

        const match = (release.assets ?? []).find((a) => a.name.endsWith(`-${suffix}`) || a.name.endsWith(suffix));
        if (match) {
          card.href = match.browser_download_url;
        } else {
          card.href = RELEASES_URL;
        }
      });
    } catch {
      if (versionLabel) {
        versionLabel.textContent = "Latest build available on GitHub";
      }
      cards.forEach((card) => {
        card.href = RELEASES_URL;
      });
    }
  }

  init();
</script>

<style>
  .download-page {
    padding: 130px 24px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 80vh;
  }

  .download-header-center {
    text-align: center;
    max-width: 680px;
    margin-bottom: 48px;
  }

  .download-title {
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .download-subtitle {
    font-size: 15px;
    color: var(--fg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ag-link-changelog {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--google-blue);
    font-weight: 600;
    font-size: 13.5px;
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 1080px;
    margin-bottom: 48px;
  }

  .dl-platform-card {
    background: var(--ag-bg-surface);
    border: 1px solid var(--ag-border-light);
    border-radius: var(--radius-lg);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .dl-platform-card:hover {
    background: var(--ag-bg-surface-elevated);
    border-color: rgba(49, 134, 255, 0.4);
    transform: translateY(-3px);
  }

  .dl-platform-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ag-border);
  }

  .dl-icon {
    width: 28px;
    height: 28px;
    color: #fff;
    flex-shrink: 0;
  }

  .dl-name {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }

  .dl-ver {
    font-size: 12.5px;
    color: var(--fg-muted);
  }

  .dl-buttons-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ag-btn-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--ag-border);
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    transition: all 0.15s ease;
  }

  .ag-btn-tile:hover {
    background: var(--google-blue);
    border-color: var(--google-blue);
  }

  .ag-btn-tile .ext {
    font-family: var(--font-ag-mono);
    font-size: 11px;
    opacity: 0.7;
  }

  .releases-link-note {
    font-size: 14px;
    color: var(--fg-muted);
  }

  .releases-link-note a {
    color: var(--google-blue);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
