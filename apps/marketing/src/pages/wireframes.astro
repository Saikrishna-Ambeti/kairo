---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Kairo Wireframes & Design Explorations"
  description="Explore wireframe screens and early architectural UX flows for Kairo."
>
  <div class="wireframe-page-wrapper">
    <!-- Header Banner -->
    <section class="wireframe-hero">
      <div class="ag-container">
        <div class="wireframe-header-content">
          <div class="hero-badge-pill">
            <span class="symbol icon-purple">palette</span>
            <span>Design Explorations &amp; UX Prototypes</span>
          </div>
          <h1 class="wireframe-title">Kairo Design Wireframes</h1>
          <p class="wireframe-desc">
            Explore the early design directions for Kairo: calm everyday assistant canvas, workspace rails, briefing cards, split memory view, and desktop installation flows.
          </p>
          <div class="wireframe-quick-actions">
            <a href="/wireframes.html" target="_blank" class="ag-btn ag-btn--primary">
              <span class="symbol">open_in_new</span>
              <span>Open Raw Canvas in Full Screen</span>
            </a>
            <a href="/" class="ag-btn ag-btn--secondary">
              <span class="symbol">arrow_back</span>
              <span>Back to Main Website</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Embedded Wireframe Studio & Screen Explorer -->
    <section class="wireframe-studio-section">
      <div class="ag-container">
        <div class="section-title-wrap">
          <span class="section-chip">Design Deck</span>
          <h2>Wireframe Screens &amp; Flows</h2>
          <p class="section-subtext">
            Browse through all screen explorations from the design document.
          </p>
        </div>

        <!-- Direct Embedded Iframe for Complete Original Fidelity -->
        <div class="wireframe-iframe-container">
          <div class="iframe-toolbar">
            <div class="window-dots">
              <span class="w-dot dot-r"></span>
              <span class="w-dot dot-y"></span>
              <span class="w-dot dot-g"></span>
            </div>
            <div class="iframe-address-bar">
              <span class="symbol icon-sm">lock</span>
              <span>kairo.internal / wireframe-screens</span>
            </div>
            <a href="/wireframes.html" target="_blank" class="toolbar-link">
              <span class="symbol">fullscreen</span>
            </a>
          </div>
          <iframe
            src="/wireframes.html"
            title="Kairo Wireframes Canvas"
            class="wireframe-embed-frame"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .wireframe-page-wrapper {
    padding-top: 80px;
    padding-bottom: 120px;
    color: var(--text-primary, #fff);
  }

  .wireframe-hero {
    padding: 60px 0 40px;
    text-align: center;
  }

  .wireframe-header-content {
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .wireframe-title {
    font-size: clamp(32px, 5vw, 54px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #ffffff 30%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .wireframe-desc {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  .wireframe-quick-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 10px;
  }

  .wireframe-studio-section {
    padding: 60px 0;
  }

  .section-title-wrap {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .section-title-wrap h2 {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .section-subtext {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .wireframe-iframe-container {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #14151a;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .iframe-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .w-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .dot-r { background: #ff5f56; }
  .dot-y { background: #ffbd2e; }
  .dot-g { background: #27c93f; }

  .iframe-address-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 0, 0, 0.3);
    padding: 5px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-family: ui-monospace, Menlo, monospace;
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .toolbar-link {
    color: rgba(255, 255, 255, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .toolbar-link:hover {
    color: #fff;
  }

  .wireframe-embed-frame {
    width: 100%;
    height: 850px;
    border: none;
    display: block;
    background: #f0eee9;
  }

  @media (max-width: 768px) {
    .wireframe-embed-frame {
      height: 600px;
    }
  }
</style>
