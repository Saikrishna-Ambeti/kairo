---
interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Kairo. The agentic control plane for coding agents",
  description = "Experience liftoff with Kairo. Coordinate Claude Code, Codex CLI, and OpenCode with direct local stdio, zero token markup, and persistent memory.",
  pageClass,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0e12" />

    <!-- OpenGraph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Antigravity Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,slnt,wdth,wght,ROND@8..144,-10..0,25..150,400..700,0..100&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Architects+Daughter&family=Caveat:wght@500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Symbols:opsz,wght,FILL,GRAD,ROND@20..48,100..700,0..1,-50..200,0..100&display=block"
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <!-- Background Ambient Grid and Particles container -->
    <div class="antigravity-bg" aria-hidden="true">
      <div class="space-mesh"></div>
      <div class="orb-glow orb-1"></div>
      <div class="orb-glow orb-2"></div>
    </div>

    <!-- Antigravity Global Header -->
    <header class="ag-header" id="main-header">
      <div class="header-container">
        <div class="header-left">
          <a href="/" class="ag-logo-wrap" aria-label="Kairo Home">
            <img
              src="/logo.png"
              alt="Kairo Logo"
              class="ag-symbol-logo"
              width="30"
              height="30"
              style="border-radius: 7px; object-fit: cover;"
            />
            <span class="ag-brand-text">kairo</span>
            <span class="ag-version-badge">2.0</span>
          </a>

          <!-- Desktop Navigation -->
          <nav class="ag-nav" aria-label="Main Navigation">
            <a href="#features" class="ag-nav-btn">
              <span>Features</span>
            </a>
            <a href="#modes" class="ag-nav-btn">
              <span>App Modes</span>
            </a>
            <a href="#download" class="ag-nav-btn">
              <span>Downloads</span>
            </a>
          </nav>
        </div>

        <div class="header-right">
          <!-- Command Palette Trigger -->
          <button class="cmd-search-btn" id="cmd-k-trigger" title="Search (⌘K)" aria-label="Search">
            <span class="symbol search-icon">search</span>
            <span class="search-label">Search</span>
            <kbd class="kbd-badge">⌘K</kbd>
          </button>

          <a
            class="ag-ghost-btn"
            href="https://github.com/pingdotgg/kairo"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Repository"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
            <span id="nav-star-count">GitHub</span>
          </a>

          <a href="#download" class="ag-pill-btn ag-pill-btn--primary">
            <span>Download</span>
            <span class="symbol">download</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main View Content -->
    <main class="main-page-root">
      <slot />
    </main>

    <!-- Google Antigravity Giant Footer -->
    <footer class="ag-footer">
      <div class="footer-container k-reveal">
        <div class="footer-upper">
          <div class="footer-pitch k-reveal">
            <h3 class="footer-headline">Experience liftoff.</h3>
            <p class="footer-desc">
              The agentic control plane built for developer trust. Zero token markup, direct stdio JSON-RPC, and persistent memory across sessions.
            </p>
            <div class="footer-status-pill" id="footer-telemetry">
              <span class="live-dot"></span>
              <span id="footer-status-text">All systems operational &middot; 14ms stdio latency &middot; v2.0.4</span>
            </div>
          </div>

          <div class="footer-nav-columns k-reveal">
            <div class="footer-col">
              <h4>Product</h4>
              <a href="#features">Features</a>
              <a href="#features">Supermemory</a>
              <a href="#modes">4 App Modes</a>
              <a href="#providers">Providers Matrix</a>
              <a href="#download">Downloads</a>
            </div>
            <div class="footer-col">
              <h4>Engines</h4>
              <a href="https://claude.com/product/claude-code" target="_blank" rel="noopener noreferrer">Claude Code 3.7</a>
              <a href="https://developers.openai.com/codex" target="_blank" rel="noopener noreferrer">OpenAI Codex CLI</a>
              <a href="https://opencode.ai" target="_blank" rel="noopener noreferrer">OpenCode</a>
            </div>
            <div class="footer-col">
              <h4>Resources</h4>
              <a href="https://github.com/pingdotgg/kairo" target="_blank" rel="noopener noreferrer">GitHub repo</a>
              <a href="https://github.com/pingdotgg/kairo/releases" target="_blank" rel="noopener noreferrer">Releases</a>
              <a href="https://discord.gg/jn4EGJjrvv" target="_blank" rel="noopener noreferrer">Discord community</a>
              <a href="https://github.com/pingdotgg/kairo/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom-bar k-reveal">
          <div class="footer-legal">
            &copy; {new Date().getFullYear()} Kairo Authors. Google Antigravity design. MIT Licensed.
          </div>
          <div class="footer-bottom-links">
            <a href="https://github.com/pingdotgg/kairo" target="_blank" rel="noopener noreferrer">Source code</a>
            <span>&middot;</span>
            <a href="https://discord.gg/jn4EGJjrvv" target="_blank" rel="noopener noreferrer">Community</a>
            <span>&middot;</span>
            <a href="#download">Get Kairo</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Command Palette Modal (⌘K) -->
    <div class="ag-cmd-overlay" id="cmd-palette" aria-hidden="true">
      <div class="ag-cmd-dialog" role="dialog" aria-modal="true">
        <div class="ag-cmd-input-wrap">
          <span class="symbol">search</span>
          <input type="text" id="cmd-input" placeholder="Type a command or section name..." autocomplete="off" />
          <kbd class="kbd-esc">ESC</kbd>
        </div>
        <div class="ag-cmd-results" id="cmd-results-list">
          <div class="cmd-group-label">SECTIONS</div>
          <a href="#hero" class="ag-cmd-item active" data-cmd-item>
            <span class="symbol">rocket_launch</span>
            <div>
              <strong>Liftoff Hero</strong>
              <small>Overview and quick start</small>
            </div>
          </a>
          <a href="#features" class="ag-cmd-item" data-cmd-item>
            <span class="symbol">tune</span>
            <div>
              <strong>Features &amp; Intelligence</strong>
              <small>Document intelligence, Supermemory, and connected tools</small>
            </div>
          </a>
          <a href="#modes" class="ag-cmd-item" data-cmd-item>
            <span class="symbol">view_quilt</span>
            <div>
              <strong>4 App Modes Matrix</strong>
              <small>Calm Canvas, Rails, Briefings, and Split Inspector</small>
            </div>
          </a>
          <a href="#trailer" class="ag-cmd-item" data-cmd-item>
            <span class="symbol">play_circle</span>
            <div>
              <strong>Video Demo Theater</strong>
              <small>60-second animated overview</small>
            </div>
          </a>
          <a href="#providers" class="ag-cmd-item" data-cmd-item>
            <span class="symbol">terminal</span>
            <div>
              <strong>CLI Providers Matrix</strong>
              <small>Claude Code, Codex, and OpenCode</small>
            </div>
          </a>
          <a href="#download" class="ag-cmd-item" data-cmd-item>
            <span class="symbol">download</span>
            <div>
              <strong>Download Installers</strong>
              <small>macOS, Windows, and Linux desktop binaries</small>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Floating Back to Top Button -->
    <button id="back-to-top" class="ag-back-to-top" title="Back to top" aria-label="Back to top">
      <span class="symbol">arrow_upward</span>
    </button>

    <!-- Global Toast Notification Container -->
    <div id="ag-toast" class="ag-toast" aria-live="polite"></div>

    <!-- Global Interactive Ambient Cursor Follower & Sparkle Trail Canvas -->
    <div id="k-cursor-glow" class="k-cursor-glow" aria-hidden="true"></div>
    <canvas id="k-cursor-particles" class="k-cursor-particles" aria-hidden="true"></canvas>

    <!-- Client Script: Command Palette, Sticky Header, GitHub Stars -->
    <script>
      // 1. Header scroll reactivity
      const header = document.getElementById("main-header");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 20) {
          header?.classList.add("is-scrolled");
        } else {
          header?.classList.remove("is-scrolled");
        }
      });

      // 2. Command Palette (⌘K)
      const palette = document.getElementById("cmd-palette");
      const trigger = document.getElementById("cmd-k-trigger");
      const input = document.getElementById("cmd-input") as HTMLInputElement | null;
      const cmdItems = document.querySelectorAll<HTMLAnchorElement>("[data-cmd-item]");

      let selectedIndex = 0;

      function updateActiveItem() {
        const visibleItems = Array.from(cmdItems).filter((item) => item.style.display !== "none");
        visibleItems.forEach((item, idx) => {
          if (idx === selectedIndex) item.classList.add("active");
          else item.classList.remove("active");
        });
      }

      function openCmd() {
        if (!palette) return;
        palette.classList.add("is-active");
        palette.setAttribute("aria-hidden", "false");
        selectedIndex = 0;
        updateActiveItem();
        setTimeout(() => input?.focus(), 40);
      }

      function closeCmd() {
        if (!palette) return;
        palette.classList.remove("is-active");
        palette.setAttribute("aria-hidden", "true");
        if (input) input.value = "";
        cmdItems.forEach((item) => (item.style.display = "flex"));
      }

      trigger?.addEventListener("click", openCmd);

      // Search filtering & Arrow keys
      input?.addEventListener("input", () => {
        const query = (input.value || "").toLowerCase().trim();
        cmdItems.forEach((item) => {
          const text = item.textContent?.toLowerCase() || "";
          if (text.includes(query)) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });
        selectedIndex = 0;
        updateActiveItem();
      });

      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (palette?.classList.contains("is-active")) closeCmd();
          else openCmd();
          return;
        }
        if (palette?.classList.contains("is-active")) {
          const visibleItems = Array.from(cmdItems).filter((item) => item.style.display !== "none");
          if (e.key === "Escape") {
            closeCmd();
          } else if (e.key === "ArrowDown") {
            e.preventDefault();
            selectedIndex = (selectedIndex + 1) % (visibleItems.length || 1);
            updateActiveItem();
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            selectedIndex = (selectedIndex - 1 + visibleItems.length) % (visibleItems.length || 1);
            updateActiveItem();
          } else if (e.key === "Enter") {
            e.preventDefault();
            if (visibleItems[selectedIndex]) {
              visibleItems[selectedIndex].click();
            }
          }
        }
      });

      palette?.addEventListener("click", (e) => {
        if (e.target === palette) closeCmd();
      });

      cmdItems.forEach((item) => {
        item.addEventListener("click", () => closeCmd());
      });

      // 3. Back to Top Button
      const backToTopBtn = document.getElementById("back-to-top");
      window.addEventListener("scroll", () => {
        if (window.scrollY > 450) {
          backToTopBtn?.classList.add("is-visible");
        } else {
          backToTopBtn?.classList.remove("is-visible");
        }
      }, { passive: true });

      backToTopBtn?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      // 4. Global Toast Notification Helper
      (window as any).showToast = (msg: string, icon = "check_circle") => {
        const toast = document.getElementById("ag-toast");
        if (!toast) return;
        toast.innerHTML = `<span class="symbol" style="color:#4ade80">${icon}</span><span>${msg}</span>`;
        toast.classList.add("is-visible");
        setTimeout(() => {
          toast.classList.remove("is-visible");
        }, 2600);
      };

      // 3. Dropdown toggles
      const dropdownWrap = document.querySelector(".ag-nav-dropdown-wrap");
      dropdownWrap?.addEventListener("mouseenter", () => {
        dropdownWrap.classList.add("is-open");
      });
      dropdownWrap?.addEventListener("mouseleave", () => {
        dropdownWrap.classList.remove("is-open");
      });

      // 4. Fetch live GitHub stars
      async function loadStars() {
        try {
          const res = await fetch("https://api.github.com/repos/pingdotgg/kairo");
          if (!res.ok) return;
          const data = await res.json();
          const count = data.stargazers_count;
          const starEl = document.getElementById("nav-star-count");
          if (starEl && count) {
            starEl.textContent = `★ ${(count / 1000).toFixed(1)}k`;
          }
        } catch {
          // fallback
        }
      }
      loadStars();

      // 5. Antigravity Footer Letters Zero-G Hover Levitation Physics
      const letters = document.querySelectorAll<SVGPathElement>(".ag-letter");
      letters.forEach((letter) => {
        letter.addEventListener("mouseenter", () => {
          letter.style.transform = `translateY(-24px) rotate(${Math.random() * 8 - 4}deg) scale(1.05)`;
          letter.style.filter = `drop-shadow(0 15px 25px rgba(49, 134, 255, 0.6))`;
          letter.style.fill = `#3186FF`;
        });
        letter.addEventListener("mouseleave", () => {
          letter.style.transform = `translateY(0) rotate(0deg) scale(1)`;
          letter.style.filter = `none`;
          letter.style.fill = `currentColor`;
        });
      });

      // 6. Global Interactive Cursor Glow & Bioluminescent Sparkle Physics
      const cursorGlow = document.getElementById("k-cursor-glow");
      const cursorCanvas = document.getElementById("k-cursor-particles") as HTMLCanvasElement | null;
      let particleCtx: CanvasRenderingContext2D | null = null;
      if (cursorCanvas) {
        particleCtx = cursorCanvas.getContext("2d");
        const resize = () => {
          if (!cursorCanvas) return;
          cursorCanvas.width = window.innerWidth;
          cursorCanvas.height = window.innerHeight;
        };
        resize();
        window.addEventListener("resize", resize, { passive: true });
      }

      interface Sparkle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        alpha: number;
        hue: number;
      }
      const sparkles: Sparkle[] = [];
      let gMouseX = -200;
      let gMouseY = -200;
      let curGlowX = -200;
      let curGlowY = -200;

      window.addEventListener("mousemove", (e) => {
        gMouseX = e.clientX;
        gMouseY = e.clientY;

        if (Math.random() < 0.45 && sparkles.length < 40) {
          sparkles.push({
            x: e.clientX + (Math.random() - 0.5) * 16,
            y: e.clientY + (Math.random() - 0.5) * 16,
            vx: (Math.random() - 0.5) * 0.8,
            vy: (Math.random() - 0.5) * 0.8 - 0.3,
            size: Math.random() * 2 + 1,
            alpha: 0.85,
            hue: Math.random() < 0.5 ? 190 : 275,
          });
        }
      }, { passive: true });

      const animateGlobalCursor = () => {
        curGlowX += (gMouseX - curGlowX) * 0.14;
        curGlowY += (gMouseY - curGlowY) * 0.14;
        if (cursorGlow) {
          cursorGlow.style.transform = `translate3d(${curGlowX - 160}px, ${curGlowY - 160}px, 0)`;
        }

        if (particleCtx && cursorCanvas) {
          particleCtx.clearRect(0, 0, cursorCanvas.width, cursorCanvas.height);
          for (let i = sparkles.length - 1; i >= 0; i--) {
            const sp = sparkles[i];
            sp.x += sp.vx;
            sp.y += sp.vy;
            sp.alpha -= 0.02;
            if (sp.alpha <= 0) {
              sparkles.splice(i, 1);
              continue;
            }
            particleCtx.beginPath();
            particleCtx.arc(sp.x, sp.y, sp.size, 0, Math.PI * 2);
            particleCtx.fillStyle = `hsla(${sp.hue}, 90%, 75%, ${sp.alpha})`;
            particleCtx.shadowColor = `hsl(${sp.hue}, 90%, 65%)`;
            particleCtx.shadowBlur = 8;
            particleCtx.fill();
          }
        }
        requestAnimationFrame(animateGlobalCursor);
      };
      requestAnimationFrame(animateGlobalCursor);
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Google Antigravity Signature Palette */
    --ag-bg: #090a0f;
    --ag-bg-surface: #12141c;
    --ag-bg-surface-elevated: #1a1d28;
    --ag-bg-card: rgba(22, 26, 38, 0.7);
    --ag-bg-card-hover: rgba(30, 36, 52, 0.9);

    --ag-border: rgba(255, 255, 255, 0.08);
    --ag-border-light: rgba(255, 255, 255, 0.14);
    --ag-border-hover: rgba(255, 255, 255, 0.25);

    --google-blue: #3186FF;
    --google-red: #FC413D;
    --google-yellow: #FBBC04;
    --google-green: #00B95C;

    --fg-text: #f4f5f8;
    --fg-secondary: #9aa0a6;
    --fg-muted: #6b7280;
    --fg-faint: #4b5563;

    --font-ag-sans: "Google Sans Flex", "Plus Jakarta Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-ag-mono: "Google Sans Code", "JetBrains Mono", monospace;

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 24px;
    --radius-xl: 32px;
    --radius-pill: 9999px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background-color: var(--ag-bg);
    color-scheme: dark;
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  body {
    background: var(--ag-bg);
    color: var(--fg-text);
    font-family: var(--font-ag-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* Universal Reveal Animation Utility */
  .k-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .k-reveal.is-revealed,
  .k-reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .k-reveal-scale {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .k-reveal-scale.is-revealed,
  .k-reveal-scale.in-view {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Google Symbols Icon Font */
  .symbol {
    font-family: "Google Symbols";
    font-weight: 300;
    font-style: normal;
    font-size: 20px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-variation-settings: "FILL" 0, "wght" 300, "GRAD" 0, "ROND" 50, "opsz" 24;
  }

  .symbol.filled {
    font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "ROND" 50, "opsz" 24;
  }

  /* Ambient Cosmic Mesh */
  .antigravity-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .space-mesh {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: radial-gradient(ellipse at 50% 15%, black 35%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 15%, black 35%, transparent 80%);
  }

  .orb-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
    opacity: 0.28;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #3186FF 0%, transparent 70%);
    top: -150px;
    left: 15%;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #FC413D 0%, transparent 70%);
    top: 25%;
    right: 5%;
    opacity: 0.18;
  }

  /* Header */
  .ag-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    padding: 18px 0;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ag-header.is-scrolled {
    padding: 10px 0;
    background: rgba(9, 10, 15, 0.82);
    backdrop-filter: blur(20px);
