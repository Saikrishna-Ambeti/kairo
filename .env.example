# Optional cloud configuration for source builds.
# `cp .env.example .env` enables Clerk sign-in and the hosted Cloud API.
# These values are public identifiers, not secrets. Managed relay remains disabled
# until KAIRO_RELAY_URL and KAIRO_CLERK_CLI_OAUTH_CLIENT_ID are configured.
# Do not add server-side secrets to this file.

# Clerk instance. Get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications. `clerk env pull` also
# works: Kairo accepts the generated CLERK_PUBLISHABLE_KEY when this key is absent.
KAIRO_CLERK_PUBLISHABLE_KEY=pk_test_bWFnbmV0aWMtcGFudGhlci00NDA5LmNsZXJrLmFjY291bnRzLmRldiQ
KAIRO_CLERK_JWT_TEMPLATE=kairo-relay
# KAIRO_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in KAIRO_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# KAIRO_APPLE_TEAM_ID=ABC1234567
# KAIRO_MACOS_PROVISIONING_PROFILE=/absolute/path/to/kairo.provisionprofile
# KAIRO_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional managed relay. `infra/relay` deployments update this automatically.
# KAIRO_RELAY_URL=https://relay.example.com

# Hosted app and Cloud API deployments.
KAIRO_HOSTED_APP_URL=https://kairo-web-ebon-three.vercel.app
KAIRO_CLOUD_API_URL=https://kairo-cloud-api.vercel.app

# Public, ingest-only mobile OpenTelemetry configuration.
# KAIRO_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# KAIRO_MOBILE_OTLP_TRACES_DATASET=kairo-mobile-traces-dev
# KAIRO_MOBILE_OTLP_TRACES_TOKEN=xaat-...
