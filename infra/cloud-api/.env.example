# Vercel runtime secrets
CLERK_SECRET_KEY=sk_...
CLERK_JWT_AUDIENCE=kairo-relay
SUPERMEMORY_API_KEY=sm_...
COMPOSIO_API_KEY=ak_...
KAIRO_CLOUD_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KAIRO_CLOUD_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
KAIRO_MEMORY_NAMESPACE_HMAC_KEY=replace-with-at-least-32-random-bytes

# Runtime configuration
KAIRO_CLOUD_ISSUER=kairo-cloud
SUPERMEMORY_API_URL=https://api.supermemory.ai
COMPOSIO_API_URL=https://backend.composio.dev
